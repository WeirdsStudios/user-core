# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Grabaciones originales en GIF.
# Se convirtieron a WebM/MP4 en la Fase 2 (55 MB → 3.5 MB) y ninguna página las
# solicita: se comprobó recorriendo las 22 rutas y registrando cada archivo que
# el navegador pide de verdad. Se dejan de versionar para que no viajen en cada
# despliegue; las copias locales siguen en public/imgs/portfolio/.
public/imgs/portfolio/*.gif
